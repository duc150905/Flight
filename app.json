{
  "expo": {
    "name": "Flyora",
    "slug": "Flight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "flight",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00B8D0",
        "foregroundImage": "./assets/branding/app-icon.png"
      },
      "package": "me.shopyora.flyora",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00B8D0",
          "image": "./assets/branding/app-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "dd7869ed-b325-44ae-b31b-f9a93ed07a5c"
      }
    },
    "owner": "deamoniis-team"
  }
}
